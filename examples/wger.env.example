# Add these to the .env next to your existing wger compose file.
STRAVA_CONNECTOR_VERSION=0.3.0
STRAVA_WGER_BASE_URL=http://web:8000
STRAVA_WGER_TOKEN=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WORKOUT_TIMEZONE=America/Edmonton
STRAVA_EXPORT_SINCE=

# Enable after configuring the companion browser worker.
STRAVA_MEDIA_ENABLED=false
STRAVA_MEDIA_UNITS=lb
